# Ejemplo de variables de entorno para TiquetApp
# Copia este archivo como .env y configura tus propios valores

# Configuración de Supabase
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_key_aqui

# Configuración de la aplicación
EXPO_PUBLIC_APP_NAME=TiquetApp
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_ENV=development
